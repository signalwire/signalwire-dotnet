<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SignalWire.Examples</RootNamespace>
    <AssemblyName>RestAuditHarness</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin/RestAuditHarness/</BaseOutputPath>
    <BaseIntermediateOutputPath>obj/RestAuditHarness/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="RestAuditHarness.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\SignalWire\SignalWire.csproj" />
  </ItemGroup>
</Project>
