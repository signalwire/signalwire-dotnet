<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SignalWire.Tools.EnvelopeDump</RootNamespace>
    <AssemblyName>EnvelopeDump</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin/EnvelopeDump/</BaseOutputPath>
    <BaseIntermediateOutputPath>obj/EnvelopeDump/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SignalWire\SignalWire.csproj" />
  </ItemGroup>
</Project>
