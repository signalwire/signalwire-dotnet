<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>SignalWire</RootNamespace>
    <AssemblyName>SignalWire</AssemblyName>
    <PackageId>SignalWire.Sdk</PackageId>
    <Version>3.0.0</Version>
    <Authors>SignalWire</Authors>
    <Description>SignalWire SDK for .NET — build AI voice agents, control live calls over WebSocket, and manage resources over REST.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/signalwire/signalwire-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/signalwire/signalwire-dotnet</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <!-- 6.3 doc-surface floor (dotnet): ship the compiler XML doc file in the
         nupkg so IDE IntelliSense/tooltips work from the package (the .xml is
         asserted present by the NUPKG-XMLDOC gate). CS1591 (missing XML
         comment on a public member) + CS1573 (some-but-not-all params
         documented — pervasive in the generated REST tree's id/cancellationToken
         params) are suppressed: doc COVERAGE is a separate ratchet concern; the
         floor here is that the documented surface SHIPS. Malformed-doc errors
         (CS1570 bad XML, CS1574/CS0419 broken crefs) stay hard errors. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internal test seams (e.g. WebSearchSkill.ScrapeHandlerFactory,
         which lets the web_search latency-control tests inject a delaying
         HttpMessageHandler) to the test assembly only. Internal members are
         invisible to the public-surface audit, so this adds no drift. -->
    <InternalsVisibleTo Include="SignalWire.Tests" />
    <!-- The Layer-D DUMP program (tools/DumpCorpus) reads observable state via a
         handful of internal accessors (GetGlobalData / GetSipUsernames /
         GetRoutingCallbackPaths / GetVerbNames / GetRegisteredSkillNames /
         LookupSipRoute) so the cross-port behavioral differs can byte-compare
         against the Python oracle. Keeping these internal (mirrors Python's
         underscore-private state) means they add NO public-surface drift. -->
    <InternalsVisibleTo Include="DumpCorpus" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SWML/schema.json" LogicalName="SignalWire.SWML.schema.json" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- YamlDotNet is the .NET-idiomatic YAML library; used by POM
         to mirror Python's ``PromptObjectModel.from_yaml/to_yaml``. -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <!-- JsonSchema.Net (json-everything) is the .NET-idiomatic Draft 2020-12
         JSON Schema validator, the analogue of Python's jsonschema-rs
         (Draft202012Validator), Go's santhosh-tekuri/jsonschema, Rust's
         `jsonschema` crate, and Ruby's json_schemer. It backs the SWML
         STRICT-RENDER contract: standard-verb configs are validated against the
         bundled schema.json (unknown/misspelled keys + wrong types are rejected,
         not silently dropped). .NET's regex engine supports the schema's
         negative-lookahead step-name patterns natively (unlike Go's RE2), so no
         custom regex engine is needed. It adds no SignalWire.* public surface. -->
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel (the .NET-idiomatic cross-platform HTTPS server) backs the
         server-TLS path in SWML.Service.Run(). The BCL HttpListener can serve
         plain HTTP everywhere but CANNOT terminate TLS on Linux (cert binding
         needs http.sys / netsh, Windows-only) — so HTTPS goes through Kestrel,
         mirroring Python's uvicorn ssl_certfile/ssl_keyfile path. The shared
         ASP.NET Core framework is referenced (not a NuGet download); it adds
         no SignalWire.* public surface, so the signature audit is unaffected. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
