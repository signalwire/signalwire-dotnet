<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>SignalWire</RootNamespace>
    <AssemblyName>SignalWire</AssemblyName>
    <PackageId>SignalWire.Sdk</PackageId>
    <Version>1.1.2</Version>
    <Authors>SignalWire</Authors>
    <Description>SignalWire SDK for .NET — build AI voice agents, control live calls over WebSocket, and manage resources over REST.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/signalwire/signalwire-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/signalwire/signalwire-dotnet</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internal test seams (e.g. WebSearchSkill.ScrapeHandlerFactory,
         which lets the web_search latency-control tests inject a delaying
         HttpMessageHandler) to the test assembly only. Internal members are
         invisible to the public-surface audit, so this adds no drift. -->
    <InternalsVisibleTo Include="SignalWire.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SWML/schema.json" LogicalName="SignalWire.SWML.schema.json" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- YamlDotNet is the .NET-idiomatic YAML library; used by POM
         to mirror Python's ``PromptObjectModel.from_yaml/to_yaml``. -->
    <PackageReference Include="YamlDotNet" Version="16.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel (the .NET-idiomatic cross-platform HTTPS server) backs the
         server-TLS path in SWML.Service.Run(). The BCL HttpListener can serve
         plain HTTP everywhere but CANNOT terminate TLS on Linux (cert binding
         needs http.sys / netsh, Windows-only) — so HTTPS goes through Kestrel,
         mirroring Python's uvicorn ssl_certfile/ssl_keyfile path. The shared
         ASP.NET Core framework is referenced (not a NuGet download); it adds
         no SignalWire.* public surface, so the signature audit is unaffected. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
