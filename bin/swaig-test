#!/usr/bin/env dotnet-script
// swaig-test -- CLI tool for testing SWAIG endpoints
//
// Two modes:
//
//   1. URL mode (HTTP, original): hits a running service over the wire.
//        swaig-test --url http://user:pass@host:3000/route --list-tools
//
//   2. File / assembly mode (in-process reflection): loads a built SDK
//      assembly, instantiates a SignalWire.SWML.Service subclass, and
//      reads the runtime tool registry directly. NO HTTP. This works on
//      a SWMLService-only example that doesn't have an <ai> verb to
//      walk, where URL-mode --list-tools would return nothing.
//        swaig-test --assembly path/to/Example.dll --class My.Ns.MyService --list-tools
//
// Options:
//   --url <url>           SWAIG endpoint URL (URL mode)
//   --assembly <path>     Path to a built .dll containing the user's Service subclass
//   --class <fqtype>      Fully-qualified name of a SignalWire.SWML.Service subclass
//   --dump-swml           Fetch and display the SWML document (URL mode)
//   --list-tools          List available SWAIG tools (URL or assembly mode)
//   --exec <tool>         Execute a specific SWAIG tool (URL mode)
//   --param <key=value>   Pass a parameter (repeatable, URL mode --exec)
//   --raw                 Output raw JSON without formatting
//   --parse-only          Validate arguments and exit (prints 'parse OK'); alias --dry-run
//   --verbose             Enable verbose output
//   --help                Show this help message
//
// URL auth extraction: if the URL contains user:pass@host, the credentials
// are extracted and used for Basic Auth.
//
// In assembly mode the script does NOT need a compile-time #r against
// SignalWire.dll: when Assembly.LoadFrom() pulls in the user's DLL, the
// CLR resolves SignalWire.dll from beside it (we hook the load-context
// resolver below to make sure of that), and we reach the SDK types
// purely via reflection.

#nullable enable

using System;
using System.Collections;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Net;
using System.Net.Http;
using System.Net.Http.Headers;
using System.Reflection;
using System.Runtime.Loader;
using System.Text;
using System.Text.Json;

var options = ParseArgs(Args.ToArray());

// ===== PARSE-ONLY / DRY-RUN =====
// Position-independent: --parse-only / --dry-run is recognized anywhere in the
// arg list (including trailing an --exec, since ParseArgs consumes flags by name
// rather than position). ParseArgs has already validated every flag and exited
// non-zero (2) on an unknown/malformed option before reaching here. On a valid
// invocation we print exactly "parse OK" and exit 0 WITHOUT loading the agent,
// touching the filesystem, or hitting the network. Mirrors the Python reference
// (signalwire/cli/test_swaig.py) and the cross-port DOC-CLI gate contract.
if (options.ParseOnly)
{
    Console.WriteLine("parse OK");
    return;
}

if (options.Help)
{
    PrintHelp();
    return;
}

if (options.HasAssembly)
{
    // ----- File / assembly mode (in-process, no HTTP) ------------------
    if (string.IsNullOrEmpty(options.ClassName))
    {
        Console.Error.WriteLine("Error: --assembly requires --class <FQTYPE>");
        Environment.Exit(1);
    }

    try
    {
        RunAssemblyMode(options);
    }
    catch (Exception ex)
    {
        Console.Error.WriteLine($"Error: {ex.Message}");
        if (options.Verbose)
            Console.Error.WriteLine(ex.StackTrace);
        Environment.Exit(1);
    }
    return;
}

if (!options.HasUrl && string.IsNullOrEmpty(options.Exec))
{
    PrintHelp();
    return;
}

if (!options.HasUrl)
{
    Console.Error.WriteLine("Error: --url is required (or use --assembly + --class for in-process mode)");
    Environment.Exit(1);
}

// NB: a plain `var` (not `using var`): a top-level `using var` declaration is a
// directive-vs-declaration ambiguity under dotnet-script's script compilation
// (CS1002). The process exits immediately after the action runs, so the OS
// reclaims the connection — explicit disposal buys nothing for a one-shot CLI.
var client = new HttpClient { Timeout = TimeSpan.FromSeconds(30) };

// Apply auth if extracted from URL
if (options.AuthUser is not null && options.AuthPassword is not null)
{
    var creds = Convert.ToBase64String(Encoding.UTF8.GetBytes($"{options.AuthUser}:{options.AuthPassword}"));
    client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Basic", creds);
}

client.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));

try
{
    if (options.DumpSwml)
    {
        await DumpSwml(client, options);
    }
    else if (options.ListTools)
    {
        await ListTools(client, options);
    }
    else if (!string.IsNullOrEmpty(options.Exec))
    {
        await ExecTool(client, options);
    }
    else
    {
        // Consistent default action: a target with no action flag errors
        // rather than silently dumping SWML. Matches the cross-port majority
        // (go/java/ruby/php/perl/rust/cpp/ts all error) and the SWAIG-CLI gate.
        Console.Error.WriteLine("Error: one of --dump-swml, --list-tools, or --exec is required");
        Environment.Exit(1);
    }
}
catch (HttpRequestException ex)
{
    Console.Error.WriteLine($"HTTP error: {ex.Message}");
    Environment.Exit(1);
}
catch (Exception ex)
{
    Console.Error.WriteLine($"Error: {ex.Message}");
    if (options.Verbose)
        Console.Error.WriteLine(ex.StackTrace);
    Environment.Exit(1);
}

// ======================================================================
// File / assembly mode
// ======================================================================

static void RunAssemblyMode(CliOptions opts)
{
    var asmPath = Path.GetFullPath(opts.AssemblyPath);
    if (!File.Exists(asmPath))
    {
        throw new FileNotFoundException($"Assembly not found: {asmPath}");
    }
    if (opts.Verbose) Console.Error.WriteLine($"LoadFrom: {asmPath}");

    // Resolve dependencies relative to the loaded assembly's directory
    // so the user's example DLL can find SignalWire.dll next to it.
    var asmDir = Path.GetDirectoryName(asmPath)!;
    AssemblyLoadContext.Default.Resolving += (ctx, name) =>
    {
        var candidate = Path.Combine(asmDir, name.Name + ".dll");
        return File.Exists(candidate) ? ctx.LoadFromAssemblyPath(candidate) : null;
    };

    var asm = Assembly.LoadFrom(asmPath);

    var t = asm.GetType(opts.ClassName);
    if (t is null)
    {
        var available = string.Join(", ", asm.GetExportedTypes().Select(x => x.FullName));
        throw new InvalidOperationException(
            $"Type '{opts.ClassName}' not found in {Path.GetFileName(asmPath)}. Exported types: {available}");
    }

    // Resolve SignalWire.SWML.Service from the SDK assembly *as the loaded
    // example sees it*. We can't just typeof(Service) because the SDK
    // referenced by this script may differ from the one the example was
    // compiled against; LoadFrom unifies on the same load context, but
    // we still want the runtime check to mirror what the user wrote.
    var serviceType = ResolveServiceType(asm);
    if (!serviceType.IsAssignableFrom(t))
    {
        throw new InvalidOperationException(
            $"Type '{opts.ClassName}' does not extend SignalWire.SWML.Service");
    }

    object? instance;
    try
    {
        instance = Activator.CreateInstance(t);
    }
    catch (MissingMethodException)
    {
        throw new InvalidOperationException(
            $"Type '{opts.ClassName}' must have a parameterless constructor for --assembly mode");
    }
    if (instance is null)
    {
        throw new InvalidOperationException($"Activator.CreateInstance returned null for '{opts.ClassName}'");
    }

    if (opts.ListTools)
    {
        ListToolsFromInstance(instance, serviceType, opts.Raw);
        return;
    }

    // Consistent default action: assembly mode requires an explicit action
    // (today only --list-tools is implemented for it). Erroring instead of
    // silently listing matches the cross-port no-action contract; --exec /
    // --dump-swml remain URL-only.
    Console.Error.WriteLine(
        "Error: --assembly mode requires --list-tools (--exec / --dump-swml are URL-only)");
    Environment.Exit(1);
}

static Type ResolveServiceType(Assembly userAsm)
{
    // Find SignalWire.SWML.Service in any assembly currently loaded into
    // this process. After Assembly.LoadFrom(userDll) the user's assembly
    // and its dependencies (notably SignalWire.dll, resolved by the load
    // hook in RunAssemblyMode) are in AppDomain.CurrentDomain.
    foreach (var asm in AppDomain.CurrentDomain.GetAssemblies())
    {
        var t = asm.GetType("SignalWire.SWML.Service");
        if (t != null) return t;
    }

    // Fall back: explicitly load each of the user's referenced
    // assemblies and check those, in case lazy loading hasn't happened.
    foreach (var refName in userAsm.GetReferencedAssemblies())
    {
        Assembly? loaded;
        try { loaded = Assembly.Load(refName); }
        catch { continue; }
        var t = loaded.GetType("SignalWire.SWML.Service");
        if (t != null) return t;
    }

    throw new InvalidOperationException(
        "Could not resolve SignalWire.SWML.Service from any loaded assembly. " +
        "Ensure SignalWire.dll is reachable from the example DLL.");
}

static void ListToolsFromInstance(object instance, Type serviceType, bool raw)
{
    var toolsProp = serviceType.GetProperty("Tools",
        BindingFlags.Public | BindingFlags.Instance);
    if (toolsProp is null)
    {
        throw new InvalidOperationException(
            "SignalWire.SWML.Service has no public 'Tools' accessor. " +
            "Update the SDK to expose IReadOnlyList<IReadOnlyDictionary<string,object>> Tools.");
    }

    var toolsValue = toolsProp.GetValue(instance);
    if (toolsValue is not IEnumerable enumerable)
    {
        Console.WriteLine("(no tools)");
        return;
    }

    var rendered = new List<Dictionary<string, object?>>();
    foreach (var entry in enumerable)
    {
        if (entry is not IEnumerable<KeyValuePair<string, object>> kvs)
        {
            continue;
        }
        var dict = new Dictionary<string, object?>();
        foreach (var kv in kvs)
        {
            dict[kv.Key] = kv.Value;
        }
        rendered.Add(dict);
    }

    if (raw)
    {
        var json = JsonSerializer.Serialize(rendered, new JsonSerializerOptions
        {
            WriteIndented = true,
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
        });
        Console.WriteLine(json);
        return;
    }

    if (rendered.Count == 0)
    {
        Console.WriteLine("(no tools registered)");
        return;
    }

    foreach (var tool in rendered)
    {
        var name = tool.TryGetValue("function", out var n) ? n?.ToString() ?? "?" : "?";
        var purpose = tool.TryGetValue("purpose", out var p) ? p?.ToString() ?? "" : "";
        Console.WriteLine($"  {name}");
        if (!string.IsNullOrEmpty(purpose))
        {
            Console.WriteLine($"    description: {purpose}");
        }
        if (tool.TryGetValue("argument", out var argObj)
            && argObj is IEnumerable<KeyValuePair<string, object>> argDict)
        {
            foreach (var ak in argDict)
            {
                if (ak.Key == "properties"
                    && ak.Value is IEnumerable<KeyValuePair<string, object>> props)
                {
                    Console.WriteLine($"    parameters:");
                    foreach (var prop in props)
                    {
                        Console.WriteLine($"      - {prop.Key}: {RenderParam(prop.Value)}");
                    }
                }
            }
        }
    }
}

static string RenderParam(object? value)
{
    if (value is null) return "null";
    if (value is IEnumerable<KeyValuePair<string, object>> dict)
    {
        var parts = new List<string>();
        foreach (var kv in dict)
        {
            parts.Add($"{kv.Key}={kv.Value}");
        }
        return string.Join(", ", parts);
    }
    return value.ToString() ?? "";
}

// ======================================================================
// URL-mode commands (unchanged)
// ======================================================================

static async Task DumpSwml(HttpClient client, CliOptions opts)
{
    if (opts.Verbose) Console.Error.WriteLine($"GET {opts.BaseUrl}");

    var response = await client.GetAsync(opts.BaseUrl);
    response.EnsureSuccessStatusCode();

    var body = await response.Content.ReadAsStringAsync();
    OutputJson(body, opts.Raw);
}

static async Task ListTools(HttpClient client, CliOptions opts)
{
    var swaigUrl = opts.BaseUrl.TrimEnd('/') + "/swaig";
    if (opts.Verbose) Console.Error.WriteLine($"POST {swaigUrl}");

    var payload = JsonSerializer.Serialize(new { action = "get_signature" });
    var content = new StringContent(payload, Encoding.UTF8, "application/json");
    var response = await client.PostAsync(swaigUrl, content);
    response.EnsureSuccessStatusCode();

    var body = await response.Content.ReadAsStringAsync();

    if (opts.Raw)
    {
        Console.WriteLine(body);
        return;
    }

    try
    {
        using var doc = JsonDocument.Parse(body);
        var root = doc.RootElement;

        if (root.ValueKind == JsonValueKind.Array)
        {
            foreach (var tool in root.EnumerateArray())
            {
                var name = tool.TryGetProperty("function", out var fn)
                    ? fn.TryGetProperty("name", out var n) ? n.GetString() : "?"
                    : "?";
                var desc = tool.TryGetProperty("function", out var fn2)
                    ? fn2.TryGetProperty("description", out var d) ? d.GetString() : ""
                    : "";
                Console.WriteLine($"  {name,-30} {desc}");
            }
        }
        else
        {
            OutputJson(body, false);
        }
    }
    catch (JsonException)
    {
        Console.WriteLine(body);
    }
}

static async Task ExecTool(HttpClient client, CliOptions opts)
{
    var swaigUrl = opts.BaseUrl.TrimEnd('/') + "/swaig";
    if (opts.Verbose) Console.Error.WriteLine($"POST {swaigUrl} (exec: {opts.Exec})");

    var arguments = new Dictionary<string, object>();
    foreach (var kvp in opts.Params)
    {
        arguments[kvp.Key] = kvp.Value;
    }

    var payload = JsonSerializer.Serialize(new
    {
        action = "execute",
        function = opts.Exec,
        argument = new { parsed = new List<Dictionary<string, object>> { arguments } },
    });

    var content = new StringContent(payload, Encoding.UTF8, "application/json");
    var response = await client.PostAsync(swaigUrl, content);
    response.EnsureSuccessStatusCode();

    var body = await response.Content.ReadAsStringAsync();
    OutputJson(body, opts.Raw);
}

static void OutputJson(string json, bool raw)
{
    if (raw)
    {
        Console.WriteLine(json);
        return;
    }

    try
    {
        using var doc = JsonDocument.Parse(json);
        var formatted = JsonSerializer.Serialize(doc, new JsonSerializerOptions { WriteIndented = true });
        Console.WriteLine(formatted);
    }
    catch (JsonException)
    {
        Console.WriteLine(json);
    }
}

// ======================================================================
// Argument parsing
// ======================================================================

static CliOptions ParseArgs(string[] args)
{
    var opts = new CliOptions();

    for (int i = 0; i < args.Length; i++)
    {
        switch (args[i])
        {
            case "--url":
                if (i + 1 < args.Length)
                {
                    ParseUrl(args[++i], opts);
                }
                break;
            case "--assembly":
                if (i + 1 < args.Length)
                {
                    opts.AssemblyPath = args[++i];
                    opts.HasAssembly = true;
                }
                break;
            case "--class":
                if (i + 1 < args.Length)
                {
                    opts.ClassName = args[++i];
                }
                break;
            case "--dump-swml":
                opts.DumpSwml = true;
                break;
            case "--list-tools":
                opts.ListTools = true;
                break;
            case "--exec":
                if (i + 1 < args.Length)
                    opts.Exec = args[++i];
                break;
            case "--param":
                if (i + 1 < args.Length)
                {
                    var param = args[++i];
                    var eqIdx = param.IndexOf('=');
                    if (eqIdx > 0)
                    {
                        opts.Params[param[..eqIdx]] = param[(eqIdx + 1)..];
                    }
                }
                break;
            case "--raw":
                opts.Raw = true;
                break;
            case "--parse-only":
            case "--dry-run":
                // Validate args and exit without loading the agent or hitting the
                // network. Recognized anywhere in argv (position-independent).
                opts.ParseOnly = true;
                break;
            case "--verbose":
                opts.Verbose = true;
                break;
            case "--help":
            case "-h":
                opts.Help = true;
                break;
            default:
                // Reject unknown options loudly rather than silently ignoring
                // them. A silently-swallowed flag (e.g. --simulate-serverless,
                // which this port does not implement) would let a caller think
                // it took effect. The cross-port swaig-test contract requires an
                // unknown/unimplemented option to error, not no-op.
                if (args[i].StartsWith("-"))
                {
                    Console.Error.WriteLine($"Error: unknown option '{args[i]}'");
                    Environment.Exit(2);
                }
                break;
        }
    }

    return opts;
}

static void ParseUrl(string url, CliOptions opts)
{
    try
    {
        var uri = new Uri(url);

        // Extract auth from userinfo if present
        if (!string.IsNullOrEmpty(uri.UserInfo))
        {
            var parts = uri.UserInfo.Split(':', 2);
            opts.AuthUser = Uri.UnescapeDataString(parts[0]);
            opts.AuthPassword = parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : "";

            // Rebuild URL without auth
            var builder = new UriBuilder(uri) { UserName = "", Password = "" };
            opts.BaseUrl = builder.Uri.ToString().TrimEnd('/');
        }
        else
        {
            opts.BaseUrl = url.TrimEnd('/');
        }
        opts.HasUrl = true;
    }
    catch (UriFormatException)
    {
        opts.BaseUrl = url.TrimEnd('/');
        opts.HasUrl = true;
    }
}

static void PrintHelp()
{
    Console.WriteLine(@"swaig-test -- CLI tool for testing SWAIG endpoints

Usage:
  dotnet script swaig-test -- --url <url> [options]
  dotnet script swaig-test -- --assembly <dll> --class <fqtype> --list-tools

Options:
  --url <url>           SWAIG endpoint URL (URL mode, HTTP)
  --assembly <path>     Path to a built .dll (in-process reflection mode)
  --class <fqtype>      Fully-qualified Service-subclass name to instantiate
  --dump-swml           Fetch and display the SWML document (URL mode)
  --list-tools          List available SWAIG tools
  --exec <tool>         Execute a specific SWAIG tool (URL mode)
  --param <key=value>   Pass a parameter (repeatable, --exec)
  --raw                 Output raw JSON without formatting
  --parse-only          Validate arguments and exit (prints 'parse OK'); alias --dry-run
  --verbose             Enable verbose output
  --help                Show this help message

URL Authentication:
  If the URL contains user:pass@host, the credentials are
  extracted and used for Basic Auth automatically.

Modes:
  URL mode hits a running service over HTTP. It works against any
  host that serves /swaig (AgentBase or plain SWMLService).

  Assembly mode loads the user's compiled assembly in-process,
  instantiates a Service subclass, and reads the runtime tool
  registry directly. This works on a SWMLService-only example
  that has no <ai> verb to walk; URL-mode --list-tools returns
  nothing in that case because it asks the LLM endpoint.

Examples:
  swaig-test --url http://user:pass@localhost:3000 --dump-swml
  swaig-test --url http://localhost:3000 --list-tools
  swaig-test --url http://localhost:3000 --exec lookup --param name=John
  swaig-test --assembly bin/Debug/net9.0/MyExample.dll --class My.Ns.MyService --list-tools");
}

// ======================================================================
// Options model
// ======================================================================

class CliOptions
{
    public string BaseUrl { get; set; } = "";
    public bool HasUrl { get; set; }
    public string? AuthUser { get; set; }
    public string? AuthPassword { get; set; }
    public string AssemblyPath { get; set; } = "";
    public bool HasAssembly { get; set; }
    public string ClassName { get; set; } = "";
    public bool DumpSwml { get; set; }
    public bool ListTools { get; set; }
    public string? Exec { get; set; }
    public Dictionary<string, string> Params { get; } = new();
    public bool Raw { get; set; }
    public bool Verbose { get; set; }
    public bool Help { get; set; }
    public bool ParseOnly { get; set; }
}
